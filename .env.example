# Copy to .env.local and fill in. .env.local is git-ignored, so credentials never land in source code.

# --- MySQL 8.0.16+ (MariaDB / XAMPP will NOT work: the schema uses SKIP LOCKED, generated-column UNIQUEs, CHECKs) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=hospital_dispatch

# --- MongoDB 6+ (local or Atlas) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=hospital_dispatch_nosql

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
